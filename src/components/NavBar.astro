---
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/docs/getting-started', label: 'Docs' },
];
---
<header class="sticky top-0 z-40 border-b bg-white/70 dark:bg-gray-900/70 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between p-4">
    <a href="/" class="font-bold">Atriva AI</a>
    <ul class="flex gap-6">
      {links.map(l => <li><a href={l.href} class="hover:underline">{l.label}</a></li>)}
    </ul>
    <button id="theme-toggle" aria-label="Toggle dark mode" class="rounded px-2 py-1">
      🌙
    </button>
  </nav>
</header>
<script>
  const btn = document.getElementById('theme-toggle');
  const set = (d)=>document.documentElement.classList.toggle('dark', d);
  set(localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches));
  btn?.addEventListener('click', () => {
    const d = !document.documentElement.classList.contains('dark');
    set(d); localStorage.theme = d ? 'dark' : 'light';
  });
</script>
