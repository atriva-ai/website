---
import "../styles/global.css";
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title || "Atriva AI"}</title>
    <meta name="description" content={description || ""} />

    <!-- Tailwind stylesheet -->
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="font-sans bg-gray-50 text-gray-800">
    <!-- Header with site title + navigation -->
    <header class="p-6 shadow bg-white">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <h1 class="text-2xl font-bold">
          <a href="/">Atriva AI</a>
        </h1>
        <nav class="flex gap-6 text-gray-700 font-medium">
          <a href="/benefits" class="hover:text-blue-600">Benefits</a>
          <a href="/resources" class="hover:text-blue-600">Resources</a>
          <a href="/services" class="hover:text-blue-600">Services</a>
          <a href="/contact" class="hover:text-blue-600">Contact</a>
        </nav>
      </div>
    </header>

    <!-- Main content -->
    <main class="max-w-4xl mx-auto p-6">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="p-6 text-center text-sm text-gray-500">
      © {new Date().getFullYear()} Atriva AI
    </footer>
  </body>
</html>
