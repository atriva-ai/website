---
import "../styles/global.css";
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title || "Atriva AI"}</title>
    <meta name="description" content={description || ""} />

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="font-sans bg-gray-50 text-gray-800">
    <header class="p-6 shadow bg-white">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center">
          <img src="/images/logo.svg" alt="Atriva AI Logo" class="mr-3" style="height:3.0em" />
          <span class="text-xl font-bold">Vision AI at the Edge</span>
        </a>
        <nav class="flex gap-6 text-gray-700 font-medium">
          <a href="/benefits" class="hover:text-blue-600">Benefits</a>
          <a href="/resources" class="hover:text-blue-600">Resources</a>
          <a href="/services" class="hover:text-blue-600">Services</a>
          <a href="/contact" class="hover:text-blue-600">Contact</a>
        </nav>
      </div>
    </header>

    {title && (
      <section class="max-w-4xl mx-auto px-6 py-8 text-center">
        <h1 class="text-3xl font-bold">{title}</h1>
        {description && <p class="mt-2 text-lg text-gray-600">{description}</p>}
      </section>
    )}

    <!-- prose class applies Typography styles -->
    <main class="prose prose-lg max-w-4xl mx-auto px-6 pb-12">
      <slot />
    </main>

    <footer class="p-6 text-center text-sm text-gray-500">
      © {new Date().getFullYear()} Atriva AI
    </footer>
  </body>
</html>
